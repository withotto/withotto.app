---
import { SEO } from "astro-seo";
import type { SEOProps } from "astro-seo";
import ChatwootWidget from "@components/ChatwootWidget.astro";
import "@fontsource-variable/rethink-sans";
import "../styles/global.css";

export interface Props {
  title?: string;
  affiliateProgramId?: string;
  seo?: Partial<SEOProps>;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, affiliateProgramId, seo = {}, jsonLd } = Astro.props;

// One <script type="application/ld+json"> per object. "<" is escaped so the
// data can never close the script element early.
const jsonLdScripts = (jsonLd ? [jsonLd].flat() : []).map((data) =>
  JSON.stringify(data).replace(/</g, "\\u003c"),
);

const makeTitle = title
  ? title + " — " + "With Otto"
  : "With Otto — practical software for accountants and bookkeepers";

const defaultCanonical = new URL(Astro.url.pathname, Astro.site).toString();
const defaultImage = new URL("/opengraph.png", Astro.site).toString();
const defaultDescription =
  "Practical automation tools for UK accounting and bookkeeping practices. Otto Capture for receipts and bills; Otto Bank Rec supporting existing customers through 2026. Built by a practice that uses its own software.";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta name="viewport" content="width=device-width" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme colour for mobile browsers -->
    <meta name="theme-color" content="#02AC8A" />
    <meta name="msapplication-TileColor" content="#02AC8A" />

    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {affiliateProgramId && (
      <script
        src="https://pushlapgrowth.com/affiliate-tracker.js"
        data-affiliate
        data-program-id={affiliateProgramId}
        async></script>
    )}

    {jsonLdScripts.map((json) => (
      <script is:inline type="application/ld+json" set:html={json}></script>
    ))}

    <SEO
      charset="UTF-8"
      canonical={defaultCanonical}
      title={makeTitle}
      description={defaultDescription}
      openGraph={{
        basic: {
          url: defaultCanonical,
          type: "website",
          title: makeTitle,
          image: defaultImage,
        },
        image: {
          alt: defaultDescription,
        },
        ...seo.openGraph,
      }}
      {...seo}
    />
  </head>
  <body class="flex min-h-full flex-col font-sans antialiased">
    <slot />
    <ChatwootWidget />
  </body>
</html>
