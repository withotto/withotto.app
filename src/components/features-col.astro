---
import { Icon } from "astro-icon/components";

const features = [
  {
    icon: "hugeicons:ai-brain-05",
    title: "Intelligent matching",
    description:
      "Otto uses machine learning to learn each client's reconciliation patterns from that client's own history.",
  },
  {
    icon: "hugeicons:circle-gauge",
    title: "Only when he's confident",
    description:
      "Otto only reconciles a transaction when he's confident enough. He leaves the rest for you to reconcile in Xero, and the portal shows why he skipped each one.",
  },
  {
    icon: "hugeicons:thumbs-up",
    title: "Guided learning",
    description:
      "Your feedback helps Otto improve. Tell him about a transaction he should have reconciled, and with SmartMatch enabled he reconciles it on his next run. Your feedback also goes into his next retraining.",
  },
  {
    icon: "hugeicons:search-list-01",
    title: "See what Otto did",
    description:
      "Track Otto's work across your clients in the portal: how many reconciliations of each type he made, and the reason for each SmartMatch he made or skipped.",
  },
  {
    icon: "hugeicons:fingerprint-pattern",
    title: "Unique to each client",
    description:
      "Otto creates a unique reconciliation model for each client, adapting to their specific clients, suppliers, and bank transactions.",
  },
  {
    icon: "hugeicons:square-lock-02",
    title: "Secure access",
    description:
      "Add Otto to your practice through Xero HQ using the same secure access management you use for staff members, maintaining full control over client access.",
  },
];
---

<div class="grid grid-cols-1 gap-16 md:grid-cols-2">
  {features.map((feature) => (
    <div class="flex flex-wrap justify-center gap-4 sm:flex-nowrap sm:justify-start sm:gap-8">
      <div>
        <div class="flex h-28 w-28 items-center justify-center rounded-full bg-primary-soft text-primary-strong">
          <Icon name={feature.icon} size={32} class="size-7/12" />
        </div>
      </div>
      <div class="text-center sm:text-start">
        <h3 class="text-2xl font-semibold text-primary-strong">
          {feature.title}
        </h3>
        <p class="pt-2 text-default">{feature.description}</p>
      </div>
    </div>
  ))}
</div>
