---
import Container from "@components/container.astro";
import Avatar from "assets/avatar.svg";
import { Image } from "astro:assets";
---

<div class="bg-white py-24">
  <Container>
    <div class="mx-auto grid max-w-4xl gap-8 lg:grid-cols-3 lg:gap-16">
      <div class="col-span-1 flex items-center justify-center">
        <div class="relative size-64">
          <div
            class="relative aspect-square h-full overflow-hidden rounded-full bg-primary-soft shadow-lg ring-4 ring-primary lg:absolute lg:inset-0">
            <div class="absolute inset-0">
              <Image
                src={Avatar}
                alt="Otto: a friendly gentleman with a round face, bushy eyebrows and moustache, and rosy cheeks"
                class="mt-10 h-[90%] w-full"
                layout="none"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="col-span-2 flex flex-col justify-center">
        <h2 class="text-5xl font-bold text-primary-strong">
          Meet Otto, your practice assistant
        </h2>

        <div class="mt-8">
          <p class="text-left text-lg leading-relaxed text-default">
            I take on the repetitive work that fills your day, so you can spend
            more time on the parts that need your judgement. Whether it's
            reconciling bank transactions or reading receipts, I learn how your
            practice works and put my suggestions in front of you to check.
          </p>
        </div>
      </div>
    </div>
  </Container>
</div>
