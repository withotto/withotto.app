---
// Otto Capture pricing block: the tier cards plus the pricing promises.
// `full` is /capture/'s block: tier cards, the VAT line and every promise with
// its explanation. `compact` is for platform pages, whose copy carries its own
// VAT line: tier cards plus the labels of the two promises in
// `compactPromiseKeys`, with no explanations. `unit` says what each price is
// for: "client" on the practice pages, "business" on the page for businesses
// doing their own books. The surrounding section (heading, intro and closing
// copy) belongs to the page.
import { Icon } from "astro-icon/components";
import { priceUnitLabels, pricingPromises, pricingTiers } from "@lib/capture";
import type { PriceUnit, PricingPromiseKey } from "@lib/capture";

interface Props {
  variant: "full" | "compact";
  unit?: PriceUnit;
}

const { variant, unit = "client" } = Astro.props;

const compactPromiseKeys: PricingPromiseKey[] = [
  "no-documents",
  "cheapest-tier",
];
const compactPromises = pricingPromises.filter((promise) =>
  compactPromiseKeys.includes(promise.key),
);
---

<div class="mt-12 grid gap-6 md:grid-cols-3">
  {pricingTiers.map((tier) => (
    <div class="flex flex-col rounded-xl border border-muted-strong bg-white p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-primary-strong">{tier.name}</h3>
      <p class="mt-3 flex items-baseline gap-1.5">
        <span class="text-4xl font-bold text-primary-strong">{tier.price}</span>
        <span class="text-sm text-default-soft">{priceUnitLabels[unit]}</span>
      </p>
      <dl class="mt-6 space-y-4 border-t border-muted-strong pt-6 text-sm">
        <div>
          <dt class="text-default-soft">Included published documents</dt>
          <dd class="mt-0.5 text-base font-semibold text-default">
            {tier.included}
          </dd>
        </div>
        <div>
          <dt class="text-default-soft">Each extra document</dt>
          <dd class="mt-0.5 text-base font-semibold text-default">
            {tier.extraDocument}
          </dd>
        </div>
      </dl>
    </div>
  ))}
</div>
{variant === "full" ? (
  <>
    <p class="mt-6 text-center text-sm text-default-soft">
      Prices exclude VAT.
    </p>

    <div class="mt-16 space-y-4">
      {pricingPromises.map((promise) => (
        <div class="flex items-start gap-4 rounded-xl border border-muted-strong bg-white p-5 md:p-6">
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-primary-soft text-primary-strong">
            <Icon name={promise.icon} class="size-6" />
          </span>
          <p class="text-default">
            <span class="font-semibold text-primary-strong">
              {promise.label}
            </span>{" "}
            {promise.intent}
          </p>
        </div>
      ))}
    </div>
  </>
) : (
  <ul class="mt-6 grid gap-4 md:grid-cols-2">
    {compactPromises.map((promise) => (
      <li class="flex items-center gap-3 rounded-xl border border-muted-strong bg-white p-4 shadow-sm">
        <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary-soft text-primary-strong">
          <Icon name={promise.icon} class="size-5" />
        </span>
        <span class="font-semibold text-primary-strong">{promise.label}</span>
      </li>
    ))}
  </ul>
)}
