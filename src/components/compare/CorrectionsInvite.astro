---
// The invitation to correct a comparison: by email, or by a pull request
// against the competitor's data file in the public repo. It promises no
// response time. The surrounding section belongs to the page.
import { inlineLink } from "@lib/capture-styles";
import { dataFileUrl } from "@lib/compare";
import type { CollectionEntry } from "astro:content";

interface Props {
  competitor: CollectionEntry<"competitors">;
}

const { competitor } = Astro.props;
const { name } = competitor.data;
---

<p>
  If anything here about {name} is wrong or out of date, please tell us. Email{" "}
  <a href="mailto:support@withotto.app" class={inlineLink}>
    support@withotto.app
  </a>
  , or open a pull request against{" "}
  <a href={dataFileUrl(competitor.id)} class={inlineLink}>
    the {name} data file on GitHub
  </a>
  . Include a link to {name}'s own published page that shows the correct detail,
  and we'll check it and update this page.
</p>
