---
// The pricing scenarios: for each scenario in `pricingScenarios`, the client
// mix at stated volumes, Capture's exact monthly total from `clientCost()`,
// and the competitor's cheapest price with no commitment and its cheapest
// with one, each with its plan, billing basis and source.
//
// A pair of radio buttons switches the competitor's prices between without
// and with line items. It is plain CSS (`group-has-[…:checked]`), so it works
// without JavaScript, and both sets of prices stay in the page for the
// claim-age check. Capture's totals don't change, since it extracts line items
// as standard.
//
// Each scenario is its own captioned table, so a phone stacks them as separate
// blocks; from `md` they sit side by side. The surrounding section belongs to
// the page.
import CheckedOn from "@components/compare/CheckedOn.astro";
import ScenarioPrice from "@components/compare/ScenarioPrice.astro";
import { formatPounds, pricingTiers } from "@lib/capture";
import { clientCost } from "@lib/capture-estimate";
import {
  captureTotal,
  dataFilePath,
  mixLabel,
  mixedLinesUsage,
  pricingScenarios,
  receivedNote,
  receivedUsage,
} from "@lib/compare";
import type { CollectionEntry } from "astro:content";

interface Props {
  competitor: CollectionEntry<"competitors">;
}

const { competitor } = Astro.props;
const { name, scenarios, receivedBasis } = competitor.data;

const known = new Set<string>(pricingScenarios.map((scenario) => scenario.key));
const unknown = Object.keys(scenarios).filter((key) => !known.has(key));
if (unknown.length > 0) {
  throw new Error(
    `${dataFilePath(competitor)} has prices for scenarios that don't exist: ${unknown.join(", ")}`,
  );
}

const cards = pricingScenarios.map((scenario) => ({
  scenario,
  mix: mixLabel(scenario.groups),
  capture: captureTotal(scenario, (documents) =>
    clientCost(pricingTiers, documents),
  ),
  prices: scenarios[scenario.key] ?? {},
}));

const withId = "compare-line-items-with";
const cell = "px-4 py-3 align-top";
const radio =
  "size-4 accent-primary-strong focus-visible:ring-2 focus-visible:ring-primary-strong focus-visible:ring-offset-2 focus-visible:outline-none";
// Shown when "with line items" is chosen, and the reverse. Written out in
// full, with the radio's id, because Tailwind only generates classes it finds
// whole in the source.
const whenWith =
  "hidden group-has-[#compare-line-items-with:checked]/prices:block";
const whenWithout =
  "group-has-[#compare-line-items-with:checked]/prices:hidden";
---

<div class="group/prices">
  <fieldset class="mb-8">
    <legend class="text-base font-semibold text-default">
      {`Show ${name}'s prices`}
    </legend>
    <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-base">
      <label class="flex items-center gap-2">
        <input
          type="radio"
          name="compare-line-items"
          value="without"
          checked
          class={radio}
        />
        Without line items
      </label>
      <label class="flex items-center gap-2">
        <input
          type="radio"
          name="compare-line-items"
          value="with"
          id={withId}
          class={radio}
        />
        With line items
      </label>
    </div>
    <p class="mt-3 text-sm text-default-soft">
      {`${mixedLinesUsage.share} documents published through Otto Capture ${mixedLinesUsage.period} had lines that needed different nominal codes or tax rates. Measured on `}
      <CheckedOn date={mixedLinesUsage.measured} />.
    </p>
  </fieldset>
  <div class="grid gap-6 md:grid-cols-3">
    {cards.map(({ scenario, mix, capture, prices }) => (
      <table class="w-full table-fixed self-start border-collapse rounded-xl bg-white text-left text-base wrap-break-word shadow-sm max-md:hyphens-auto">
        <caption class="px-4 pb-3 text-left">
          <span class="block text-lg font-semibold text-primary-strong">
            {scenario.label}
          </span>
          <span class="mt-1 block text-sm text-default-soft">{mix}</span>
        </caption>
        <tbody>
          <tr class="border-b border-muted-strong">
            <th scope="row" class:list={[cell, "w-2/5 font-semibold"]}>
              Otto Capture
            </th>
            <td class={cell}>
              <span class="font-semibold">{formatPounds(capture)}</span> per
              month
            </td>
          </tr>
          <tr class="border-b border-muted-strong">
            <th scope="row" class:list={[cell, "font-semibold"]}>
              {`${name}, no commitment`}
            </th>
            <td class={cell}>
              <div class={whenWithout}>
                <ScenarioPrice price={prices.monthly} />
              </div>
              <div class={whenWith}>
                <ScenarioPrice price={prices["monthly-with-line-items"]} />
              </div>
            </td>
          </tr>
          <tr>
            <th scope="row" class:list={[cell, "font-semibold"]}>
              {`${name}, with a commitment`}
            </th>
            <td class={cell}>
              <div class={whenWithout}>
                <ScenarioPrice price={prices.committed} />
              </div>
              <div class={whenWith}>
                <ScenarioPrice price={prices["committed-with-line-items"]} />
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    ))}
  </div>
  <p class="mt-6 text-base text-default-soft">
    {`Every price excludes VAT and is for one month. Otto Capture's totals come from its pricing tiers, and include line items, which it extracts as standard. ${name}'s are the cheapest its own published pricing gives for the same clients, with no commitment and with one, on the plan and billing basis shown.`}
  </p>
  {receivedBasis && (
    <p class="mt-4 text-base text-default-soft">
      {`${receivedNote(name, receivedBasis)} Measured on `}
      <CheckedOn date={receivedUsage.measured} />.
    </p>
  )}
</div>
