---
import Container from "./container.astro";
import FaqList from "@components/faq/FaqList.astro";
import { type FaqItem } from "../types";
import { Icon } from "astro-icon/components";
interface PricingPlan {
  name: string;
  price: number;
  credits: number;
}

const plans: PricingPlan[] = [
  {
    name: "Plan A",
    price: 25.0,
    credits: 100,
  },
  {
    name: "Plan B",
    price: 52.5,
    credits: 250,
  },
  {
    name: "Plan C",
    price: 100.0,
    credits: 500,
  },
  {
    name: "Plan D",
    price: 190.0,
    credits: 1000,
  },
  {
    name: "Plan E",
    price: 297.5,
    credits: 1750,
  },
  {
    name: "Plan F",
    price: 400.0,
    credits: 2500,
  },
  {
    name: "Plan G",
    price: 750.0,
    credits: 5000,
  },
  {
    name: "Plan H",
    price: 1400.0,
    credits: 10000,
  },
];

const faqs: FaqItem[] = [
  {
    question: "What does a credit get me?",
    answer: `
      <p class="py-2">Each type of reconciliation uses a different number of credits:</p>
      <ul class="list-disc pl-5">
        <li>Bank rule matches: 1 credit per transaction</li>
        <li>SmartMatch (ML-powered): 4 credits per transaction</li>
        <li>GuidedMatch: Free, helping Otto learn and saving you time</li>
      </ul>
    `,
  },
  {
    question: "Can credits be carried over?",
    answer: `
         <p>Yes. Any unused credits roll over to the next month and don't expire while your subscription is active, so you can handle varying workloads through the year.</p>
         `,
  },
  {
    question: "What happens if I need more credits mid-month?",
    answer: `
      <p class="py-2">You can choose how to handle additional reconciliation needs.</p>
      <p class="py-2"><b>Fixed billing</b>: when your credits run out, Otto stops making reconciliations that cost credits until your next billing period starts. Free reconciliations, such as GuidedMatches and those in your practice's own books, carry on.</p>
      <p class="py-2"><b>Fixed billing with limit</b>: This works the same as fixed billing, but you decide how many extra credits Otto can use before he stops. Any extra credits he uses are charged at your plan's per-credit price.</p>
      <p class="py-2"><b>Uncapped billing</b>: Otto will continue reconciling and charge any extra credits at your plan's per-credit price on your next bill. This keeps your workflow smooth during busy periods.</p>
      <p class="py-2">You get complete visibility of credit usage with all options, and you can change your preference anytime through your practice settings.</p>
     `,
  },
  {
    question: "How can I manage credit usage across different clients?",
    answer: `
      <p class="py-2">You have complete control over how credits are used for each client. You can enable or disable different reconciliation types per client:</p>
      <ul class="list-disc pl-5">
        <li>Choose whether to use bank rule matching (1 credit)</li>
        <li>Enable or disable SmartMatch ML-powered reconciliation (4 credits)</li>
        <li>GuidedMatch is free, and Otto makes GuidedMatches only while SmartMatch is enabled for the client, not while it's in monitor mode</li>
      </ul>
      <p class="py-2">This granular control helps you optimise credit usage by choosing the right level of automation for each client's needs. For example, you might use SmartMatch for clients with complex transactions and stick to bank rules for simpler accounts.</p>
    `,
  },
];
---

<script>
  // Add scroll indicators
  const tableContainer = document.querySelector('[role="region"]');
  const leftIndicator = document.getElementById("scroll-indicator-left");
  const rightIndicator = document.getElementById("scroll-indicator-right");

  if (tableContainer && leftIndicator && rightIndicator) {
    const updateScrollIndicators = () => {
      const maxScroll = tableContainer.scrollWidth - tableContainer.clientWidth;

      if (maxScroll > 0) {
        leftIndicator.style.display =
          tableContainer.scrollLeft > 0 ? "block" : "none";
        rightIndicator.style.display =
          tableContainer.scrollLeft < maxScroll ? "block" : "none";
      } else {
        leftIndicator.style.display = "none";
        rightIndicator.style.display = "none";
      }
    };

    tableContainer.addEventListener("scroll", updateScrollIndicators);
    window.addEventListener("resize", updateScrollIndicators);

    updateScrollIndicators();
  }
</script>

<div class="py-24" id="pricing">
  <Container>
    <div>
      <h2 class="text-center text-3xl font-bold text-primary-strong md:text-5xl">
        Simple, credit-based pricing
      </h2>
      <p class="mx-auto mt-6 max-w-4xl text-lg leading-snug font-medium text-primary-strong">
        All features, unlimited clients, and full support are included, with the
        same fair pricing for the practices using Otto.
      </p>
    </div>

    <div class="mt-12">
      <div class="relative mb-5 flex items-center rounded-md border border-primary/20 bg-primary-soft px-5 py-4 shadow-sm">
        <Icon
          name="hugeicons:information-circle"
          size={32}
          class="size-7 shrink-0 text-primary-strong"
        />
        <span class="ml-3">
          Credits are shared across all your clients, helping smooth out those
          monthly and seasonal variations in transaction volume.
        </span>
      </div>
      <div class="relative">
        {/* Outer container with position relative for scroll indicators */}
        <div
          class="pointer-events-none absolute top-0 right-0 bottom-0 hidden w-12 bg-gradient-to-l from-white to-transparent md:hidden"
          aria-hidden="true"
          id="scroll-indicator-right"></div>
        <div
          class="pointer-events-none absolute top-0 bottom-0 left-0 hidden w-12 bg-gradient-to-r from-white to-transparent md:hidden"
          aria-hidden="true"
          id="scroll-indicator-left"></div>

        {/* Table container with horizontal scroll */}
        <div
          class="overflow-x-auto rounded-xl border border-muted-strong bg-white shadow-lg"
          role="region"
          aria-label="Pricing plans comparison"
          tabindex="0">
          <table class="min-w-full divide-y divide-muted-strong">
            <thead>
              <tr class="bg-primary-strong font-bold text-white">
                <th
                  scope="col"
                  class="sticky left-0 bg-primary-strong px-6 py-4 text-left text-white">
                  Plan
                </th>
                <th
                  scope="col"
                  class="bg-primary-strong px-6 py-4 text-right font-bold text-white">
                  Price
                </th>
                <th
                  scope="col"
                  class="bg-primary-strong px-6 py-4 text-right font-bold text-white">
                  Included credits
                </th>
                <th
                  scope="col"
                  class="bg-primary-strong px-6 py-4 text-right font-bold text-white">
                  Price per credit
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-muted-strong">
              {plans.map((plan, index) => (
                <tr
                  class={`${index % 2 === 0 ? "bg-white" : "bg-primary-soft"}`}>
                  <td class="sticky left-0 bg-inherit px-6 py-4 whitespace-nowrap">
                    <span class="font-medium text-default">{plan.name}</span>
                  </td>
                  <td class="px-6 py-4 text-right whitespace-nowrap">
                    <div class="font-bold text-default">
                      £
                      {plan.price.toLocaleString("en-GB", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2,
                      })}
                    </div>
                  </td>
                  <td class="px-6 py-4 text-right whitespace-nowrap">
                    <div class="text-default">
                      {plan.credits.toLocaleString("en-GB")}
                    </div>
                  </td>
                  <td class="px-6 py-4 text-right whitespace-nowrap">
                    <div class="text-default">
                      £{(plan.price / plan.credits).toFixed(2)}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="mt-8 space-y-8 text-default-soft">
      <p class="text-sm">All prices exclude VAT</p>
      <div class="relative mx-auto mb-16 flex max-w-4xl items-center rounded-md border border-primary/20 bg-primary-soft px-5 py-4 shadow-sm">
        <Icon
          name="hugeicons:calculator-01"
          size={32}
          class="size-7 shrink-0 text-primary-strong"
        />
        <span class="ml-3">
          Not sure where to start? Most practices use between 20 and 70 credits
          a month for each client Otto reconciles. Your trial shows your own
          figure, and our{" "}
          <a
            href="/files/With%20Otto%20pricing%20calculator.xlsx"
            class="text-primary-strong underline underline-offset-2 hover:decoration-2"
            download>
            pricing spreadsheet (Excel)
          </a>{" "}
          works out which plan is cheapest for the reconciliations you expect.
        </span>
      </div>

      <h3 class="text-center text-2xl font-bold text-primary-strong">
        Frequently asked questions
      </h3>
      <div class="mx-auto mt-10 flex max-w-3xl items-center justify-center">
        <FaqList items={faqs} />
      </div>
      <p class="mx-auto mt-10 max-w-3xl text-default">
        Have more questions?{" "}
        <a
          href="/faqs/"
          class="text-primary-strong underline underline-offset-2 hover:decoration-2">
          Read our full FAQs
        </a>
      </p>
    </div>
  </Container>
</div>
