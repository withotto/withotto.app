---
import { buttonClasses } from "./buttonStyles";
import type { ButtonSize, ButtonVariant } from "./buttonStyles";

interface Props {
  href: string;
  size?: ButtonSize;
  block?: boolean;
  variant?: ButtonVariant;
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "md",
  variant = "primary",
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  {...rest}
  class:list={[buttonClasses(variant, size), block && "w-full", className]}>
  <slot />
</a>
