---
import { buttonClasses } from "./buttonStyles";
import type { ButtonSize, ButtonVariant } from "./buttonStyles";

interface Props {
  size?: ButtonSize;
  block?: boolean;
  variant?: ButtonVariant;
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  variant = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;
---

<button
  {...rest}
  class:list={[buttonClasses(variant, size), block && "w-full", className]}>
  <slot />
</button>
