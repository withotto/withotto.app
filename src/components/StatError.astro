---
import { Icon } from "astro-icon/components";

interface Props {
  withIcon?: boolean;
  message?: string;
}

const { withIcon = true, message = "Error loading data" } = Astro.props;
---

{
  withIcon ? (
    <span class="inline-flex items-center gap-1 text-danger-strong">
      <Icon name="hugeicons:alert-02" size={16} class="h-4 w-4" />
      <span>{message}</span>
    </span>
  ) : (
    <span class="text-danger-strong">&mdash;</span>
  )
}
