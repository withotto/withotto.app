---
// Visible breadcrumb trail. Reads the same items as the BreadcrumbList JSON-LD
// (`breadcrumbList` in `@lib/structured-data`), so the two can't drift. Every
// item but the last is a link; the last is the current page.
import { Icon } from "astro-icon/components";
import type { BreadcrumbItem } from "@lib/structured-data";

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
const lastIndex = items.length - 1;
---

<nav aria-label="Breadcrumb" class:list={["text-sm", className]}>
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    {items.map((item, index) => (
      <li class="flex items-center gap-x-1.5">
        {index < lastIndex ? (
          <>
            <a
              href={item.path}
              class="rounded-sm text-default-soft underline decoration-default-soft/40 underline-offset-2 transition hover:text-primary-strong hover:decoration-primary-strong focus-visible:ring-2 focus-visible:ring-primary-strong focus-visible:ring-offset-2 focus-visible:outline-none">
              {item.name}
            </a>
            <Icon
              name="hugeicons:arrow-right-01"
              class="size-3.5 shrink-0 text-default-soft"
              aria-hidden="true"
            />
          </>
        ) : (
          <span aria-current="page" class="font-medium text-default">
            {item.name}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
