---
import Link from "@components/ui/link.astro";

const { asset } = Astro.props;
---

<div
  class="flex h-full flex-col rounded-lg border border-muted-strong bg-white p-6 transition-shadow hover:shadow-lg">
  <!-- Preview Area -->
  <div
    class={`mb-4 flex h-32 items-center justify-center rounded-lg p-4 ${
      asset.name.includes("white text") ? "bg-primary-strong" : "bg-muted-soft"
    }`}>
    <img
      src={asset.svgPath}
      alt={asset.name}
      class="max-h-full max-w-full object-contain"
      loading="lazy"
    />
  </div>

  <!-- Asset Info -->
  <div class="mb-4 flex-grow">
    <h3 class="mb-2 font-semibold text-default">{asset.name}</h3>
    <p class="text-sm text-default-soft">{asset.description}</p>
  </div>

  <!-- Download Buttons -->
  <div class="mt-auto space-y-2">
    <Link href={asset.pngPath} download size="sm" block>
      <svg
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
        ></path>
      </svg>
      Download PNG
    </Link>

    <Link href={asset.svgPath} download variant="outline" size="sm" block>
      <svg
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
        ></path>
      </svg>
      Download SVG
    </Link>
  </div>
</div>
