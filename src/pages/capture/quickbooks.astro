---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Button from "@components/ui/button.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Avatar from "@assets/avatar.svg";

// The brief fixes this title exactly, so it overrides the site's
// "<title> - With Otto" suffix. openGraph.basic is set alongside it, otherwise
// the shared card title would fall back to the site default and disagree.
const pageTitle =
  "QuickBooks Online receipt capture for accountants and bookkeepers | Otto Capture";
const description =
  "QuickBooks Online support for Otto Capture is in development. Join the waitlist to hear when it is available, or to help test it early.";

const seo = {
  title: pageTitle,
  description,
  openGraph: {
    basic: {
      type: "website",
      title: pageTitle,
      image: new URL("/opengraph.png", Astro.site).toString(),
      url: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  },
};

const supportEmail = "support@withotto.app";

// Until the waitlist endpoint is configured the form would fail on every
// submission, so the page falls back to the support address instead, the same
// way NewsletterSignup handles a browser with no JavaScript.
const waitlistEndpoint = import.meta.env.PUBLIC_QUICKBOOKS_WAITLIST_API_URL;

const clientCounts = ["1 to 5", "6 to 15", "16 to 50", "51 or more"];

const salesDocuments = [
  "Yes, for most clients",
  "Yes, for some clients",
  "No, purchases only",
  "Not sure",
];

// Section-heading icon chip, matching the Capture landing page.
const sectionChipLight =
  "inline-flex size-16 shrink-0 items-center justify-center rounded-full bg-primary text-white shadow-sm md:size-20";
const sectionChipIcon = "size-7 md:size-8";

const labelClass = "mb-1.5 inline-block text-sm font-medium text-default";
const optionalClass = "ml-1 font-normal text-default-soft";
const fieldClass =
  "w-full rounded-lg border border-muted/40 bg-white px-4 py-3.5 text-base text-default shadow-sm transition-colors hover:border-muted/60 focus:border-primary-strong focus:ring-1 focus:ring-primary-strong focus:outline-none";
---

<Layout seo={seo}>
  <!-- Heading and introduction -->
  <div class="bg-primary-soft pt-10 md:pt-24">
    <Container>
      <div class="mx-auto max-w-3xl pb-16">
        <div class="mb-6 flex justify-center">
          <span
            class="inline-flex items-center gap-2.5 rounded-full bg-white px-4 py-1.5 text-sm font-medium text-primary-strong shadow-sm">
            Otto Capture
            <span class="size-1 rounded-full bg-primary-medium"></span>
            QuickBooks Online in development
          </span>
        </div>
        <h1
          class="text-center text-4xl font-bold text-primary-strong md:text-6xl">
          QuickBooks Online is coming to Otto Capture
        </h1>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-default">
          <p>
            Otto Capture works with Xero and FreeAgent today, and QuickBooks
            Online is in development. It will start with bills, receipts, and
            purchase credit notes: Otto reads the document, suggests how it
            should be coded based on that client's history with the same
            supplier, and the practice reviews everything before it is
            published.
          </p>
          <p>
            Sales invoices and sales credit notes will follow, and there is a
            question on the form below about whether you need them. QuickBooks
            Online handles the sales side differently, and we would rather
            understand what practices actually need before we build it than
            guess and get it wrong.
          </p>
        </div>
      </div>
    </Container>
  </div>

  <!-- What happens next -->
  <div class="py-16">
    <Container>
      <div class="mx-auto max-w-3xl">
        <div class="flex flex-col items-center text-center">
          <span class={sectionChipLight}>
            <Icon name="hugeicons:route-01" class={sectionChipIcon} />
          </span>
          <h2 class="mt-5 text-3xl font-bold text-primary-strong md:text-5xl">
            What happens next
          </h2>
        </div>
        <p class="mt-8 text-lg leading-relaxed text-default">
          Once the integration is ready, it has to go through Intuit's review
          process before it can be listed. We would rather not guess at how long
          that takes, or exactly what will be possible at each stage, so we will
          tell you when we know. If there is an opportunity to connect a small
          number of accounts before then, the people on this list will hear
          about it first.
        </p>
      </div>
    </Container>
  </div>

  <!-- Join the waitlist -->
  <div class="bg-primary-soft py-16">
    <Container>
      <div class="mx-auto max-w-3xl">
        <div class="flex flex-col items-center text-center">
          <span class={sectionChipLight}>
            <Icon name="hugeicons:mail-account-01" class={sectionChipIcon} />
          </span>
          <h2 class="mt-5 text-3xl font-bold text-primary-strong md:text-5xl">
            Join the waitlist
          </h2>
        </div>

        <div
          class="mt-12 rounded-xl border border-muted-strong bg-white p-6 shadow-sm md:p-8">
          {
            waitlistEndpoint ? (
              <Fragment>
                {/* Shown until the script runs, so a browser without
                    JavaScript gets a route in rather than a dead form. */}
                <div id="waitlistNoJs">
                  <p class="text-lg text-default">
                    To join the QuickBooks Online waitlist, please email{" "}
                    <a
                      href={`mailto:${supportEmail}`}
                      class="font-semibold text-primary-strong underline underline-offset-2 hover:text-primary">
                      {supportEmail}
                    </a>
                    .
                  </p>
                </div>

                <form
                  id="waitlistForm"
                  class="hidden flex-col gap-6"
                  data-endpoint={waitlistEndpoint}
                  novalidate>
                  {/* Name before email, matching NewsletterSignup's order. */}
                  <div>
                    <label for="name" class={labelClass}>
                      Your name
                    </label>
                    <input
                      type="text"
                      id="name"
                      name="name"
                      required
                      autocomplete="name"
                      class={fieldClass}
                      aria-required="true"
                    />
                  </div>

                  <div>
                    <label for="email" class={labelClass}>
                      Email address
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      autocomplete="email"
                      class={fieldClass}
                      aria-required="true"
                    />
                  </div>

                  <div>
                    <label for="practice" class={labelClass}>
                      Practice name
                    </label>
                    <input
                      type="text"
                      id="practice"
                      name="practice"
                      required
                      autocomplete="organization"
                      class={fieldClass}
                      aria-required="true"
                    />
                  </div>

                  <div>
                    <label for="clientCount" class={labelClass}>
                      How many of your clients use QuickBooks Online?
                      <span class={optionalClass}>(optional)</span>
                    </label>
                    <select
                      id="clientCount"
                      name="clientCount"
                      class={fieldClass}>
                      <option value="">Choose an option</option>
                      {clientCounts.map((count) => (
                        <option value={count}>{count}</option>
                      ))}
                    </select>
                  </div>

                  <div>
                    <label for="salesDocuments" class={labelClass}>
                      Would you need to publish sales invoices and sales credit
                      notes to QuickBooks Online?
                      <span class={optionalClass}>(optional)</span>
                    </label>
                    <select
                      id="salesDocuments"
                      name="salesDocuments"
                      class={fieldClass}>
                      <option value="">Choose an option</option>
                      {salesDocuments.map((answer) => (
                        <option value={answer}>{answer}</option>
                      ))}
                    </select>
                  </div>

                  <div class="flex items-start gap-3">
                    <input
                      type="checkbox"
                      id="earlyTesting"
                      name="earlyTesting"
                      class="mt-0.5 size-5 shrink-0 rounded border-muted/40 accent-primary focus:ring-2 focus:ring-primary-strong focus:ring-offset-2 focus:outline-none"
                    />
                    <label for="earlyTesting" class="text-base text-default">
                      I would be happy to help test the integration early
                    </label>
                  </div>

                  <div
                    id="waitlistError"
                    class="hidden items-start gap-3 rounded-md border border-danger bg-danger-soft p-4"
                    role="alert">
                    <Icon
                      name="hugeicons:information-circle"
                      class="mt-0.5 size-5 shrink-0 text-danger-strong"
                    />
                    <p class="text-default">
                      Something went wrong at our end and we could not add you
                      to the list. Please try again in a moment, or{" "}
                      <a
                        href={`mailto:${supportEmail}`}
                        class="font-semibold text-primary-strong underline underline-offset-2 hover:text-primary">
                        email us
                      </a>{" "}
                      and we will add you manually.
                    </p>
                  </div>

                  <div>
                    <Button type="submit" size="lg">
                      Join the waitlist
                    </Button>
                    <p class="mt-4 text-sm text-default-soft">
                      We will only email you about QuickBooks Online support in
                      Otto Capture. You can unsubscribe at any time.
                    </p>
                  </div>
                </form>

                <div
                  id="waitlistSuccess"
                  class="hidden items-center gap-6"
                  role="status"
                  tabindex="-1">
                  <div class="hidden size-24 shrink-0 overflow-hidden rounded-full bg-primary-soft ring-4 ring-primary sm:block">
                    <Image
                      src={Avatar}
                      alt="Otto: a friendly gentleman with a round face, bushy eyebrows and moustache, and rosy cheeks"
                      class="mt-4 h-[90%] w-full"
                      layout="none"
                    />
                  </div>
                  <p class="text-lg leading-relaxed text-default">
                    Thank you. Please check your inbox and click the link in the
                    confirmation email to finish signing up. We will be in touch
                    when there is news.
                  </p>
                </div>
              </Fragment>
            ) : (
              <p class="text-lg text-default">
                To join the QuickBooks Online waitlist, please email{" "}
                <a
                  href={`mailto:${supportEmail}`}
                  class="font-semibold text-primary-strong underline underline-offset-2 hover:text-primary">
                  {supportEmail}
                </a>
                .
              </p>
            )
          }
        </div>
      </div>
    </Container>
  </div>

  <!-- Already on a supported platform -->
  <div class="py-16">
    <Container>
      <div class="mx-auto max-w-3xl">
        <div
          class="flex items-start gap-4 rounded-lg border-l-4 border-primary bg-primary-soft p-6">
          <Icon
            name="hugeicons:information-circle"
            class="mt-0.5 size-6 shrink-0 text-primary-strong"
          />
          <p class="text-default">
            Already using Xero or FreeAgent? Otto Capture is available now, with
            a 60 day free trial.{" "}
            <a
              href="/capture/"
              class="font-semibold text-primary-strong underline underline-offset-2 hover:text-primary">
              See what Otto Capture does
            </a>
          </p>
        </div>
      </div>
    </Container>
  </div>
</Layout>

<script>
  const form = document.getElementById(
    "waitlistForm",
  ) as HTMLFormElement | null;
  const noJs = document.getElementById("waitlistNoJs");
  const success = document.getElementById("waitlistSuccess");
  const error = document.getElementById("waitlistError");

  // The form is server-rendered hidden so it never appears without the
  // JavaScript that submits it.
  if (form && noJs) {
    form.classList.remove("hidden");
    form.classList.add("flex");
    noJs.classList.add("hidden");
  }

  if (form && success && error) {
    const submitButton = form.querySelector<HTMLButtonElement>(
      "button[type='submit']",
    );

    const showError = (visible: boolean) => {
      error.classList.toggle("hidden", !visible);
      error.classList.toggle("flex", visible);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        showError(true);
        return;
      }

      showError(false);
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Joining the waitlist";
      }

      const data = new FormData(form);
      const payload = {
        name: String(data.get("name") ?? "").trim(),
        email: String(data.get("email") ?? "").trim(),
        practice: String(data.get("practice") ?? "").trim(),
        clientCount: String(data.get("clientCount") ?? ""),
        salesDocuments: String(data.get("salesDocuments") ?? ""),
        earlyTesting: data.get("earlyTesting") !== null,
      };

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          throw new Error(`Waitlist request failed: ${response.status}`);
        }

        form.classList.add("hidden");
        form.classList.remove("flex");
        success.classList.remove("hidden");
        success.classList.add("flex");
        success.focus();
      } catch (err) {
        console.error(err);
        showError(true);
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = "Join the waitlist";
        }
      }
    });
  }
</script>
