#!/bin/sh
# Render the shared rules (.claude/rules/shared/) into a worktree that
# `git worktree add` has just created, which git marks with a null previous
# HEAD ($1). The user-level shared-rules hook only renders a worktree when a
# session or subagent starts in it, so a worktree made with plain git and
# worked on from another session would otherwise have none. Skipped where the
# wrapper is not installed, and never fails the checkout.
[ "$1" = 0000000000000000000000000000000000000000 ] || exit 0
s="$HOME/.claude/hooks/shared-rules-sync.sh"
[ -x "$s" ] || exit 0
"$s" --target "$(git rev-parse --show-toplevel)" </dev/null >&2 || true
