{
  "name": "withotto-v2",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "dev:all": "supabase start && astro dev --background && supabase functions serve",
    "dev:stop": "astro dev stop; supabase stop",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/checks/all.mjs",
    "check:seo": "node scripts/checks/seo.mjs",
    "check:a11y": "node scripts/checks/a11y.mjs",
    "check:links": "node scripts/checks/links.mjs",
    "test:checks": "node --test \"scripts/checks/**/*.test.mjs\"",
    "check:baseline": "node scripts/checks/baseline.mjs",
    "setup:browsers": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/rethink-sans": "5.3.0",
    "@iconify-json/hugeicons": "1.2.35",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "astro-icon": "1.2.0",
    "astro-navbar": "2.4.0",
    "astro-seo": "1.2.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "axe-core": "4.13.0",
    "cheerio": "1.2.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.118.0"
  },
  "engines": {
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.28.0"
}
