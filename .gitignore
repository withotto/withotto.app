# build output
dist/
.output/
.astro

# dependencies
node_modules/

# deno - lockfile disabled via supabase/functions/**/deno.json ("lock": false);
# ignore any stray deno.lock so Renovate jsr bumps can't leave a stale one committed
deno.lock

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env*

# macOS-specific files
.DS_Store
.claude/settings.local.json
/.claude/rules/internal/
/docs/
/.idea/
/.claude/skills/pr-feedback
/.claude/skills/review-upgrades
.playwright-cli
.codegraph/daemon.pid
.worktrees/

# Shared rules rendered from the private shared-rules repo at session start; never committed here
/.claude/rules/shared/
# Retired copies that now live in shared-rules; kept ignored so they cannot be committed again
/.claude/rules/withotto-app-brand-audience.md
/.claude/rules/withotto-app-voice-common.md
/.claude/rules/withotto-app-products.md
.claude/worktrees/
